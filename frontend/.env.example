# Base URL of the Nextalx backend API (no trailing slash).
#
# Local development (default when this variable is not set):
VITE_API_URL=http://localhost:8080/api/v1
#
# In production (e.g. Railway), set VITE_API_URL as a BUILD-TIME variable to your
# deployed backend URL, for example:
# VITE_API_URL=https://nextalx-api-production.up.railway.app/api/v1
#
# Note: Vite only exposes variables prefixed with VITE_, and they are baked in
# at build time — you must rebuild the frontend after changing this value.
